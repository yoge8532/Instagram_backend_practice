<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
</head>
<body>
    <h1>Enter the details:  </h1>
    <form action="/posts/<%= post.id %>?_method=PATCH" method="POST">
        <p>ID: <%= post.id %></p>

        <input type="number" placeholder="Likes" name="likes"
            value="<%= post.likes %>">

        <input type="number" placeholder="Comments" name="comments"
            value="<%= post.comments %>">

        <button type="submit">Submit</button>
    </form>
</body>
</html>